Your first complete project

Now your health_check.py should look like:

import subprocess

print("================================")
print("      Linux Health Check")
print("================================")

# Hostname
result = subprocess.run(
    ["hostname"],
    capture_output=True,
    text=True
)

print("Hostname:", result.stdout)

# Uptime
result = subprocess.run(
    ["uptime"],
    capture_output=True,
    text=True
)

print("\nUptime:")
print(result.stdout)

# Disk usage
result = subprocess.run(
    ["df", "-h", "/"],
    capture_output=True,
    text=True
)

print("\nDisk Usage:")
print(result.stdout)

# Memory usage
result = subprocess.run(
    ["free", "-h"],
    capture_output=True,
    text=True
)

print("\nMemory Usage:")
print(result.stdout)

# Running processes
result = subprocess.run(
    ["ps", "aux"],
    capture_output=True,
    text=True
)

print("\nRunning Processes:")
print(result.stdout)

Run:
python3 health_check.py

