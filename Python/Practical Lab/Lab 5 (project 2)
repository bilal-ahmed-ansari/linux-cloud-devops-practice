import subprocess


def run_command(command):
    result = subprocess.run(
        command,
        capture_output=True,
        text=True
    )

    return result.stdout


print("================================")
print("      Linux Health Check")
print("================================")

print("\nHostname:")
print(run_command(["hostname"]))

print("Uptime:")
print(run_command(["uptime"]))

print("Disk Usage:")
print(run_command(["df", "-h", "/"]))

print("Memory Usage:")
print(run_command(["free", "-h"]))

print("Running Processes:")
print(run_command(["ps", "aux"]))

