=> Let's show the actual Linux error

Instead of simply saying:

Command failed

we can return the actual error.

=>Program:
import subprocess


def run_command(command):
    try:
        result = subprocess.run(
            command,
            capture_output=True,
            text=True,
            check=True
        )

        return result.stdout

    except subprocess.CalledProcessError as error:
        return error.stderr


print(run_command(["hostname"]))
print(run_command(["abc123"]))

